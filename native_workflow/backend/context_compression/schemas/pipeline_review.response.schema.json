{
  "type": "object",
  "properties": {
    "request_sha256": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "PASS",
            "REVISE",
            "NEEDS_REVIEW"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "review_type": {
          "type": "string",
          "enum": [
            "MODEL_REVIEW",
            "ASSISTANT_INTERNAL_REVIEW",
            "EXPERT_REVIEW"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "JSON pointer relative to the reviewed object, not the response envelope. For context_review use /objective or /study/drug; for pipeline_review use /blocks/0 or /data_files/0. Do not prepend /context or /pipeline."
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "PRESERVED",
                  "MISSING",
                  "ALTERED",
                  "UNRESOLVED"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "verdict",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "retention": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "PRESERVED",
                  "MISSING",
                  "ALTERED",
                  "UNRESOLVED"
                ]
              },
              "critical": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "quote",
              "verdict",
              "critical",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "critical_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "decision",
        "reviewer",
        "review_type",
        "claims",
        "retention",
        "critical_errors",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "request_sha256",
    "review"
  ],
  "additionalProperties": false
}
