                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "component_id",
                    "verdict",
                    "targets",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
