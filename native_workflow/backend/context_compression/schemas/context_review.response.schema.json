              "verdict": {
                "type": "string",
                "enum": [
                  "PRESERVED",
                  "MISSING",
                  "ALTERED",
                  "UNRESOLVED"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "path",
              "quote",
              "statement",
              "status",
              "evidence",
              "verdict",
              "reason"
