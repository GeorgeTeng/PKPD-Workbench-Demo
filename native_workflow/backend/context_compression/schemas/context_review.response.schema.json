                "type": "string",
                "enum": [
                  "PRESERVED",
                  "MISSING",
                  "ALTERED",
                  "UNRESOLVED"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "component_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "PRESERVED",
                        "MISSING",
                        "ALTERED",
                        "UNRESOLVED"
