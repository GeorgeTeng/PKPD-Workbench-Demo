            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "atomic_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "JSON pointer relative to the context object, excluding /version. Use /objective, /study/drug or /data/available/0, without a /context prefix. Every scalar leaf needs exactly one evidence record."
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
