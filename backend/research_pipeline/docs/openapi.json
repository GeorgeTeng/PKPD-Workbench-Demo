  "components": {
    "schemas": {
      "Body_upload_v1_attachments_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_attachments_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IndexRequest": {
        "properties": {
          "upload_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Upload Ids"
          }
        },
        "type": "object",
        "required": [
          "upload_ids"
        ],
        "title": "IndexRequest"
      },
      "ReferenceRequest": {
        "properties": {
          "card_upload_id": {
            "type": "string",
            "title": "Card Upload Id"
          },
          "source_upload_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Upload Ids"
          },
          "drug": {
            "type": "string",
            "title": "Drug"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "card_upload_id",
          "source_upload_ids",
          "drug"
        ],
        "title": "ReferenceRequest"
      },
      "SearchRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "online",
              "local"
            ],
            "title": "Provider"
          },
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query"
          },
          "drug": {
            "type": "string",
            "minLength": 1,
            "title": "Drug"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "provider",
          "query",
          "drug"
        ],
        "title": "SearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
